#!/usr/bin/env bash
# Crimson Red — UI-screen driver smoke test (for agents)
#
# ./test_headless only LOADS the UI screens. This DRIVES them: it enters
# party/equip/shop/talents/map and sweeps synthetic hovers, clicks, keys and
# wheel ticks over each, catching call-time errors and checking the economy
# save invariants. Prints UI_SMOKE_PASS/FAIL (exit 0 on PASS, 1 on FAIL).
#
# Never touches real save slots (save.write is stubbed) and plays no audio.
# Screenshots land in the LÖVE save dir under ui_smoke/ (path is printed).
#
# Env: CR_TEST_MODE=1 skips music; CR_TEST_SCENE=ui swaps the app entry for
# ui_smoke_test.lua.
# Usage: ./test_ui         full run (about 10 minutes: three whole battles)
#        ./test_ui quick   skips the whole battles (about 3 minutes) - for UI-only work
#        ./test_ui align   only the sprite line-up screenshot (align-lineup.png): every unit
#                          with its body box, to check sprite alignment by eye (seconds)
set -euo pipefail
# A syntax error would hang LÖVE at start-up with no message: check first.
"$(dirname "$0")/check_syntax" || exit 1
cd "$(dirname "$0")/main-game"
quick=0; [ "${1:-}" = "quick" ] && quick=1
only=""; [ "${1:-}" = "align" ] && only=align
exec env CR_TEST_MODE=1 CR_TEST_SCENE=ui CR_UI_QUICK=$quick CR_UI_ONLY=$only love .
